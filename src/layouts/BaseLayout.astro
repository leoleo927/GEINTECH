---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { company } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = company.description } = Astro.props;
const pageTitle = title ? `${title} | ${company.name}` : `${company.name} | ${company.legalName}`;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#141f4d" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <!-- Open Graph: vista previa al compartir en redes -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-60 focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:shadow"
    >
      Saltar al contenido
    </a>

    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />

    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
