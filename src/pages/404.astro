---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout title="Página no encontrada">
  <section class="flex min-h-[70vh] items-center justify-center px-4 pt-28 pb-16 text-center">
    <div>
      <p class="text-7xl font-extrabold text-brand-red">404</p>
      <h1 class="mt-4 text-3xl font-bold text-brand-navy">Página no encontrada</h1>
      <p class="mt-3 text-slate-600">La página que buscas no existe o fue movida.</p>
      <Button href="/" class="mt-8">Volver al inicio</Button>
    </div>
  </section>
</BaseLayout>
