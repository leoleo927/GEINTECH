---
/**
 * Botón/enlace reutilizable con las variantes de la marca.
 * Los íconos dentro pueden animarse con `group-hover/btn:...`.
 */
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost-light' | 'light';
  size?: 'md' | 'lg';
  class?: string;
  [attribute: string]: unknown;
}

const { href, variant = 'primary', size = 'md', class: className, ...rest } = Astro.props;

const variants = {
  primary: 'bg-brand-red text-white shadow-lg shadow-brand-red/25 hover:bg-brand-red-dark',
  secondary: 'bg-brand-green text-white shadow-lg shadow-brand-green/25 hover:bg-brand-green-light',
  outline: 'border-2 border-brand-navy text-brand-navy hover:bg-brand-navy hover:text-white',
  'ghost-light': 'border-2 border-white/40 text-white hover:bg-white hover:text-brand-navy',
  light: 'bg-white text-brand-navy shadow-lg hover:bg-slate-100',
};

const sizes = {
  md: 'px-5 py-2.5 text-sm',
  lg: 'px-7 py-3.5 text-base',
};
---

<a
  href={href}
  class:list={[
    'group/btn inline-flex items-center justify-center gap-2 rounded-full font-semibold transition duration-300 hover:-translate-y-0.5',
    variants[variant],
    sizes[size],
    className,
  ]}
  {...rest}
>
  <slot />
</a>
