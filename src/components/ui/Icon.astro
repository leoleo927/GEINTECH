const brandPath = name in brandPaths ? brandPaths[name as keyof typeof brandPaths] : undefined;
---

{
  brandPath ? (
    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class={className} aria-hidden="true">
      <path d={brandPath} />
    </svg>
  ) : (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="1.5"
      stroke="currentColor"
      class={className}
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d={paths[name as keyof typeof paths]} />
    </svg>
  )
}
