---
import { Image } from 'astro:assets';
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
import { services } from '../../data/services';
---

<section id="servicios" class="bg-surface py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading
      eyebrow="Servicios"
      title="Nuestras Soluciones"
      description="Ingeniería, prevención y tecnología para blindar tu operación y asegurar tu crecimiento."
    />

    <div class="mt-14 grid gap-6 sm:grid-cols-2 xl:grid-cols-4">
      {
        services.map((service, index) => (
          <article
            class="group flex flex-col overflow-hidden rounded-2xl bg-white shadow-sm transition duration-300 hover:-translate-y-1.5 hover:shadow-xl"
            data-reveal
            style={`--reveal-delay: ${(index % 4) * 100}ms`}
          >
            {service.image ? (
              <div class="aspect-16/10 overflow-hidden">
                <Image
                  src={service.image}
                  alt={service.title}
                  format="png"
                  widths={[400, 800]}
                  sizes="(min-width: 1280px) 300px, (min-width: 640px) 50vw, 100vw"
                  class="size-full object-cover transition duration-500 group-hover:scale-105"
                />
              </div>
            ) : (
              <div class="flex aspect-16/10 items-center justify-center bg-brand-navy">
                <Icon name={service.icon} class="size-16 text-white transition duration-500 group-hover:scale-110" />
              </div>
            )}

            <div class="flex flex-1 flex-col p-7">
              <div class="flex items-center gap-3">
                <span class="text-sm font-bold text-brand-red tabular-nums">{String(index + 1).padStart(2, '0')}</span>
                <span class="h-px flex-1 bg-slate-200 transition-colors duration-500 group-hover:bg-brand-red" aria-hidden="true" />
                <Icon name={service.icon} class="size-6 text-brand-green" />
              </div>
              <h3 class="mt-4 text-xl font-bold text-brand-navy">{service.title}</h3>
              <p class="mt-3 flex-1 leading-relaxed text-slate-600">{service.description}</p>
              {service.highlights && (
                <ul class="mt-5 flex flex-wrap gap-2">
                  {service.highlights.map((item) => (
                    <li class="rounded-md bg-surface px-2.5 py-1 text-xs font-semibold text-brand-navy">{item}</li>
                  ))}
                </ul>
              )}
              <a
                href="#contacto"
                class="mt-6 inline-flex items-center gap-2 font-semibold text-brand-red transition-all group-hover:gap-3"
              >
                Solicitar información
                <Icon name="arrowRight" class="size-4" />
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
